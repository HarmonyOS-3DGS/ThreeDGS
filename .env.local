# 本地轻量运行配置（无需 Docker）
# 使用 SQLite + 内存 Celery + 本地文件存储

DATABASE_URL=sqlite:///./3dgs.db

REDIS_URL=memory://
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# 本地文件存储（替代 MinIO）
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=./local_storage

API_HOST=0.0.0.0
API_PORT=8000

# ServiceAccount 鉴权（逗号分隔 client_id:secret，空 = 关闭鉴权）
SERVICE_ACCOUNTS=dev-admin:sk-debug
JWT_SECRET_KEY=dev-jwt-secret-not-for-production
ADMIN_CLIENT_ID=dev-admin

# 任务生命周期
TASK_PENDING_TTL_HOURS=24
TASK_COMPLETED_TTL_DAYS=7

# 输出类型（逗号分隔：raw_model, spz, sog）
OUTPUT_TYPES=["raw_model"]

# 外部算法（一体化模式，本地模式下无效）
ALG_ENABLED=false
ALG_IMAGE=alg_pipeline
ALG_SCRIPT=alg_pipeline.pyc
ALG_OUTPUT_DIR=output
ALG_PLY_NAME=point_cloud.ply
ALG_PLY_SUBDIR=gaussian_splatting/out/train/grid_0_0/point_cloud
ALG_HOST_DATA_DIR=/data/3dgs
ALG_EXPECTED_SECONDS=960
ALG_MAX_SECONDS=3600
