# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/gaussian

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gaussian

# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth — ServiceAccount 鉴权（逗号分隔 client_id:secret，空 = 关闭鉴权）
SERVICE_ACCOUNTS=partner-a:sk-aaa,partner-b:sk-bbb
JWT_SECRET_KEY=change-this-to-a-random-string
ADMIN_CLIENT_ID=admin

# Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 输出类型（逗号分隔：raw_model, spz, sog）
OUTPUT_TYPES=["raw_model"]

# 任务生命周期
TASK_PENDING_TTL_HOURS=24
TASK_COMPLETED_TTL_DAYS=7
TASK_FILES_TTL_DAYS=7

# 外部算法（一体化模式）
ALG_ENABLED=false
ALG_IMAGE=alg_pipeline
ALG_SCRIPT=alg_pipeline.pyc
ALG_OUTPUT_DIR=output
ALG_PLY_NAME=point_cloud.ply
ALG_PLY_SUBDIR=gaussian_splatting/out/train/grid_0_0/point_cloud
ALG_HOST_DATA_DIR=/data/3dgs
ALG_EXPECTED_SECONDS=960
ALG_MAX_SECONDS=3600
ALG2_IMAGE=alg_image:v1
ALG2_WORK_DIR=/data/dist_so
ALG2_SCRIPT=test.py
ALG2_EXTRA_ARGS=-s -m 6 --video_mode
ALG2_PLY_NAME=recon_result.ply
ALG2_EXPECTED_SECONDS=360
ALG2_MAX_SECONDS=1800
ALG2_SHM_SIZE=64g
# PLY 搜索路径配置（一般不用改）
# ALG2_PLY_USERDATA_REL=dist_so/UserData
# ALG2_PLY_SUBDIR_PREFIX=test_task_id_tasks_
