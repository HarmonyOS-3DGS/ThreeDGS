# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/gaussian

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gaussian

# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth (leave empty to disable)
API_KEY=

# Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 输出类型（逗号分隔：raw_model, spz, sog）
OUTPUT_TYPES=raw_model

# 任务生命周期
TASK_PENDING_TTL_HOURS=24
TASK_COMPLETED_TTL_DAYS=7

# 外部算法（一体化模式）
ALG_ENABLED=false
ALG_IMAGE=alg_pipeline
ALG_SCRIPT=alg_pipeline.pyc
ALG_OUTPUT_DIR=output
ALG_PLY_NAME=point_cloud.ply
ALG_PLY_SUBDIR=gaussian_splatting/out/train/grid_0_0/point_cloud
ALG_HOST_DATA_DIR=/data/3dgs
ALG_EXPECTED_SECONDS=960
ALG_MAX_SECONDS=3600
